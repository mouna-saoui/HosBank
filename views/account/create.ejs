<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nouveau compte — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'accounts' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Ouvrir un compte', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/accounts" class="btn-link">← Retour à mes comptes</a>
      </div>

      <% if (error) { %><div class="alert alert-error"> <%= error %></div><% } %>

      <div class="form-section">
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:6px;">Ouvrir un compte bancaire</h2>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:20px;">Choisissez le type de compte qui correspond à vos besoins.</p>

        <form method="POST" action="/accounts">
          <div class="form-group">
            <label>Type de compte</label>
            <div class="account-type-options">
              <label class="option-card">
                <input type="radio" name="account_type" value="current" required>
                <div class="option-content">
                  <strong>Compte Courant</strong>
                  <p>Pour vos opérations quotidiennes, virements et paiements.</p>
                </div>
              </label>
              <label class="option-card">
                <input type="radio" name="account_type" value="savings">
                <div class="option-content">
                  <strong>Compte Épargne</strong>
                  <p>Pour faire fructifier votre argent avec des intérêts.</p>
                </div>
              </label>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Ouvrir le compte</button>
        </form>
      </div>

    </main>
  </div>
</div>
</body>
</html>
