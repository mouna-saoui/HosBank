<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mes comptes — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'accounts' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Mes comptes', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <h1>Mes comptes</h1>
        <div class="header-actions">
          <a href="/accounts/new" class="btn btn-primary">+ Nouveau compte</a>
        </div>
      </div>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <% if (accounts.length === 0) { %>
        <div class="card empty-state">
          <div class="empty-icon"></div>
          <p>Vous n'avez aucun compte bancaire pour le moment.</p>
          <a href="/accounts/new" class="btn btn-primary">Créer mon premier compte</a>
        </div>
      <% } else { %>
        <div class="accounts-grid">
          <% accounts.forEach(account => { %>
          <div class="account-card status-<%= account.status %>">
            <div class="account-card-header">
              <span class="account-type"><%= account.accountType === 'current' ? 'Compte Courant' : 'Compte Épargne' %></span>
              <span class="badge badge-<%= account.status %>">
                <%= account.status === 'active' ? 'Actif' : account.status === 'blocked' ? 'Bloqué' : 'Clôturé' %>
              </span>
            </div>
            <div class="account-number"><%= account.accountNumber %></div>
            <div class="account-balance"><%= parseFloat(account.balance).toLocaleString('fr-FR', {minimumFractionDigits:2}) %> <%= account.currency %></div>
            <div class="account-rib">RIB : <%= account.rib %></div>
            <a href="/accounts/<%= account.id %>" class="btn btn-outline btn-sm">Voir le détail →</a>
          </div>
          <% }) %>
        </div>
      <% } %>

    </main>
  </div>
</div>
</body>
</html>
