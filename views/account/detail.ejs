<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Détail compte — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'accounts' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: account.accountType === 'current' ? 'Compte Courant' : 'Compte Épargne', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/accounts" class="btn-link">← Mes comptes</a>
        <% if (account.status === 'active') { %>
        <form method="POST" action="/accounts/<%= account.id %>/close"
              onsubmit="return confirm('Confirmer la clôture de ce compte ?')">
          <button type="submit" class="btn btn-danger btn-sm">Clôturer le compte</button>
        </form>
        <% } %>
      </div>

      <% if (error) { %><div class="alert alert-error"> <%= error %></div><% } %>

      <div class="detail-card" style="margin-bottom:24px;">
        <div class="detail-row">
          <span class="label">Numéro de compte</span>
          <span class="value" style="font-family:monospace;"><%= account.accountNumber %></span>
        </div>
        <div class="detail-row">
          <span class="label">IBAN</span>
          <span class="value" style="font-family:monospace;font-size:0.82rem;"><%= account.iban %></span>
        </div>
        <div class="detail-row">
          <span class="label">RIB</span>
          <span class="value" style="font-family:monospace;"><%= account.rib %></span>
        </div>
        <div class="detail-row">
          <span class="label">Solde disponible</span>
          <span class="value balance"><%= parseFloat(account.balance).toLocaleString('fr-FR', {minimumFractionDigits:2}) %> <%= account.currency %></span>
        </div>
        <div class="detail-row">
          <span class="label">Statut</span>
          <span class="badge badge-<%= account.status %>">
            <%= account.status === 'active' ? 'Actif' : account.status === 'blocked' ? 'Bloqué' : 'Clôturé' %>
          </span>
        </div>
        <div class="detail-row">
          <span class="label">Ouvert le</span>
          <span class="value"><%= new Date(account.createdAt).toLocaleDateString('fr-FR') %></span>
        </div>
      </div>

      <div class="section-title">Historique des transactions</div>
      <% if (transactions.length === 0) { %>
        <div class="card"><p class="empty-text">Aucune transaction pour ce compte.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <div class="table-scroll">
            <table class="table">
              <thead>
                <tr><th>Date</th><th>Type</th><th>Description</th><th>Montant</th><th>Solde après</th></tr>
              </thead>
              <tbody>
                <% transactions.forEach(tx => { %>
                <tr>
                  <td style="white-space:nowrap;color:var(--text-muted);font-size:0.82rem;"><%= new Date(tx.created_at).toLocaleDateString('fr-FR') %></td>
                  <td><%= tx.transaction_type %></td>
                  <td style="color:var(--text-muted);"><%= tx.description || '—' %></td>
                  <td class="<%= tx.amount > 0 ? 'amount-positive' : 'amount-negative' %>">
                    <%= parseFloat(tx.amount).toLocaleString('fr-FR', {minimumFractionDigits:2}) %> MAD
                  </td>
                  <td><%= parseFloat(tx.balance_after).toLocaleString('fr-FR', {minimumFractionDigits:2}) %> MAD</td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </main>
  </div>
</div>
</body>
</html>
