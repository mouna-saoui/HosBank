<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="auth-page">
  <div class="auth-container">
    <div class="auth-logo">
      <div class="logo-name">HosBank</div>
      <div class="logo-sub">Votre espace bancaire sécurisé</div>
    </div>

    <h2>Bon retour</h2>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label for="email">Adresse e-mail</label>
        <input id="email" type="email" name="email" placeholder="votre@email.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input id="password" type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Se connecter</button>
    </form>

    <div class="auth-footer">
      Pas encore de compte ? <a href="/register">Créer un compte</a>
    </div>
  </div>
</div>
</body>
</html>
