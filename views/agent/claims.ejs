<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Réclamations — HosBank</title><link rel="stylesheet" href="/css/Style.css">
</head>
<body><div class="layout">
  <%- include('../layouts/sidebar', { userRole, activePage }) %>
  <div class="main-content"><%- include('../layouts/topbar', { pageTitle: 'Réclamations', userName }) %>
    <main class="page-body">
      <div class="page-header"><div><h1>Réclamations</h1><p class="text-muted">Réclamations des clients affectés</p></div></div>
      <% if (claims.length === 0) { %><div class="card empty-state"><p>Aucune réclamation.</p></div><% } else { %>
      <div class="table-wrapper"><div class="table-scroll"><table class="table">
        <thead><tr><th>Client</th><th>Sujet</th><th>Date</th><th>Statut</th><th>Action</th></tr></thead>
        <tbody><% claims.forEach(claim => { %><tr>
          <td><%= claim.first_name %> <%= claim.last_name %></td><td><%= claim.subject %></td>
          <td><%= new Date(claim.created_at).toLocaleDateString('fr-FR') %></td>
          <td><span class="badge badge-<%= claim.status %>"><%= claim.status %></span></td>
          <td><a class="btn btn-outline btn-sm" href="/agent/claims/<%= claim.id %>">Voir</a></td>
        </tr><% }) %></tbody>
      </table></div></div><% } %>
    </main>
  </div>
</div></body></html>