<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demandes — HosBank</title><link rel="stylesheet" href="/css/Style.css">
</head>
<body><div class="layout">
  <%- include('../layouts/sidebar', { userRole, activePage }) %>
  <div class="main-content"><%- include('../layouts/topbar', { pageTitle: 'Demandes', userName }) %>
    <main class="page-body">
      <div class="page-header"><div><h1>Demandes des clients</h1><p class="text-muted">Demandes des clients qui vous sont affectés</p></div></div>
      <form class="header-actions" method="GET" action="/agent/requests" style="margin-bottom:16px;">
        <select name="type">
          <option value="">Tous les types</option>
          <% requestTypes.forEach(type => { %><option value="<%= type %>" <%= requestType === type ? 'selected' : '' %>><%= type %></option><% }) %>
        </select>
        <button class="btn btn-outline btn-sm" type="submit">Filtrer</button>
      </form>
      <% if (requests.length === 0) { %><div class="card empty-state"><p>Aucune demande.</p></div><% } else { %>
      <div class="table-wrapper"><div class="table-scroll"><table class="table">
        <thead><tr><th>Client</th><th>Type</th><th>Date</th><th>Statut</th><th>Action</th></tr></thead>
        <tbody><% requests.forEach(request => { %><tr>
          <td><%= request.first_name %> <%= request.last_name %></td><td><%= request.request_type %></td>
          <td><%= new Date(request.created_at).toLocaleDateString('fr-FR') %></td>
          <td><span class="badge badge-<%= request.status %>"><%= request.status %></span></td>
          <td><a class="btn btn-outline btn-sm" href="/agent/requests/<%= request.id %>">Voir</a></td>
        </tr><% }) %></tbody>
      </table></div></div><% } %>
    </main>
  </div>
</div></body></html>