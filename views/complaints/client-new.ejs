<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nouvelle reclamation - HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'complaints' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Nouvelle reclamation', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/complaints" class="btn-link">&#x2190; Mes reclamations</a>
      </div>

      <% if (error) { %><div class="alert alert-error">&#x26A0;&#xFE0F; <%= error %></div><% } %>

      <div class="form-section">
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:6px;">Soumettre une reclamation</h2>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:20px;">
          Decrivez votre probleme en detail. Un charge client vous repondra dans les meilleurs delais et vous serez notifie par email.
        </p>

        <form method="POST" action="/complaints" id="complaint-form">

          <div class="form-group">
            <label for="subject">Sujet <span style="color:#dc2626;">*</span></label>
            <input type="text" id="subject" name="subject" required
              placeholder="Ex: Probleme de virement, carte bloquee..."
              maxlength="200" style="width:100%;">
          </div>

          <div class="form-group">
            <label for="priority">Priorite <span style="color:#dc2626;">*</span></label>
            <select id="priority" name="priority" required>
              <option value="">-- Choisir une priorite --</option>
              <option value="low">&#x1F7E2; Basse - Pas urgent</option>
              <option value="normal" selected>&#x1F7E1; Normale - Standard</option>
              <option value="high">&#x1F7E0; Haute - Important</option>
              <option value="urgent">&#x1F534; Urgent - Critique</option>
            </select>
          </div>

          <div class="form-group">
            <label for="description">Description <span style="color:#dc2626;">*</span></label>
            <textarea id="description" name="description" rows="6" required
              placeholder="Decrivez votre probleme en detail : quand cela s'est produit, quelles actions vous avez effectuees, etc."
              style="width:100%;resize:vertical;"></textarea>
            <small style="color:var(--text-muted);font-size:0.78rem;">Minimum 10 caracteres</small>
          </div>

          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button type="submit" class="btn btn-primary" id="submit-complaint">Soumettre la reclamation</button>
            <a href="/complaints" class="btn" style="background:var(--surface);color:var(--text);border:1px solid var(--border);">Annuler</a>
          </div>
        </form>
      </div>

    </main>
  </div>
</div>
</body>
</html>
