<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demander une carte virtuelle — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'cards' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Nouvelle carte virtuelle', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/cards" class="btn-link">← Mes cartes</a>
      </div>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <div class="form-section">
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:6px;">Demander une carte virtuelle</h2>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:20px;">Associez votre carte à l'un de vos comptes actifs.</p>

        <form method="POST" action="/cards">
          <div class="form-group">
            <label for="account_id">Compte à associer</label>
            <select id="account_id" name="account_id" required>
              <option value="">— Choisir un compte —</option>
              <% accounts.filter(a => a.status === 'active').forEach(a => { %>
                <option value="<%= a.id %>">
                  <%= a.account_number %> — <%= a.account_type === 'current' ? 'Courant' : 'Épargne' %>
                </option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Créer la carte virtuelle</button>
        </form>
      </div>

    </main>
  </div>
</div>
</body>
</html>
