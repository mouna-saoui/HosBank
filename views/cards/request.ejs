<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demander une carte virtuelle — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'cards' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Nouvelle carte virtuelle', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/cards" class="btn-link">← Mes cartes</a>
      </div>

      <% if (error) { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success">✅ <%= success %></div><% } %>

      <div class="form-section" style="margin-bottom:28px;">
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:6px;">Demander une carte virtuelle</h2>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:4px;">Associez votre carte à l'un de vos comptes actifs.</p>
        <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:20px;">
          ⚠️ Votre demande sera examinée par un <strong>chargé client</strong>. Vous recevrez un <strong>email de confirmation</strong> dès qu'elle sera traitée.
        </p>

        <form method="POST" action="/cards">
          <div class="form-group">
            <label for="account_id">Compte à associer</label>
            <select id="account_id" name="account_id" required>
              <option value="">— Choisir un compte —</option>
              <% accounts.filter(a => a.status === 'active').forEach(a => { %>
                <option value="<%= a.id %>">
                  <%= a.account_number %> — <%= a.account_type === 'current' ? 'Courant' : 'Épargne' %>
                </option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Soumettre la demande</button>
        </form>
      </div>

      <!-- Demandes en cours -->
      <div class="section-title">Mes demandes de carte virtuelle</div>
      <% if (!pendingRequests || pendingRequests.length === 0) { %>
        <div class="card"><p class="empty-text">Aucune demande pour le moment.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <div class="table-scroll">
            <table class="table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Compte</th>
                  <th>Date</th>
                  <th>Statut</th>
                  <th>Note</th>
                </tr>
              </thead>
              <tbody>
                <% pendingRequests.forEach(r => { %>
                <tr>
                  <td style="color:var(--text-muted);font-size:0.82rem;">#<%= r.id %></td>
                  <td style="font-size:0.85rem;"><%= r.details?.account_number || '—' %></td>
                  <td style="white-space:nowrap;color:var(--text-muted);font-size:0.82rem;"><%= new Date(r.created_at).toLocaleDateString('fr-FR') %></td>
                  <td>
                    <span class="badge badge-<%= r.status %>">
                      <%= r.status === 'pending' ? 'En attente' : r.status === 'in_review' ? 'En examen' : r.status === 'approved' ? 'Approuvée' : r.status === 'rejected' ? 'Refusée' : r.status %>
                    </span>
                  </td>
                  <td style="color:var(--text-muted);font-size:0.82rem;"><%= r.resolution_note || '—' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </main>
  </div>
</div>
</body>
</html>
