<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Cartes - HosBank</title>
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="container">
    <div class="page-header">
        <h1>Gestion des Cartes</h1>
        <div class="header-actions">
            <a href="/officer/requests/rib" class="btn-secondary">Demandes RIB</a>
            <a href="/officer/requests/savings_account" class="btn-secondary">Demandes Épargne</a>
            <a href="/logout" class="btn-link">Déconnexion</a>
        </div>
    </div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (cards.length === 0) { %>
        <p class="empty-text">Aucune carte enregistrée.</p>
    <% } else { %>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th><th>Client</th><th>Type</th><th>Numéro</th>
                <th>Compte</th><th>Statut</th><th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% cards.forEach(card => { %>
            <tr>
                <td>#<%= card.id %></td>
                <td><%= card.first_name %> <%= card.last_name %></td>
                <td><%= card.card_type %></td>
                <td>**** <%= card.last_four || '----' %></td>
                <td><%= card.account_number || '-' %></td>
                <td><span class="badge badge-<%= card.status %>"><%= card.status %></span></td>
                <td>
                    <form method="POST" action="/officer/cards/<%= card.id %>/status" style="display:flex;gap:4px;">
                        <select name="status">
                            <option value="active" <%= card.status === 'active' ? 'selected' : '' %>>Actif</option>
                            <option value="blocked" <%= card.status === 'blocked' ? 'selected' : '' %>>Bloqué</option>
                            <option value="expired" <%= card.status === 'expired' ? 'selected' : '' %>>Expiré</option>
                            <option value="cancelled" <%= card.status === 'cancelled' ? 'selected' : '' %>>Annulé</option>
                        </select>
                        <button type="submit" class="btn-secondary">Modifier</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>
</div>
</body>
</html>
