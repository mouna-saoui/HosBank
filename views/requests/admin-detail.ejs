<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Traiter la demande - HosBank</title>
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="container">
    <div class="page-header">
        <a href="/officer/requests/<%= request.request_type %>" class="btn-link">← Retour</a>
        <h1>Demande #<%= request.id %></h1>
    </div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="detail-card">
        <div class="detail-row">
            <span class="label">Client</span>
            <span class="value"><%= request.first_name %> <%= request.last_name %> (<%= request.email %>)</span>
        </div>
        <div class="detail-row">
            <span class="label">Type</span>
            <span class="value">
                <% if (request.request_type === 'rib') { %>🪪 Demande RIB
                <% } else if (request.request_type === 'savings_account') { %>🏦 Ouverture compte épargne
                <% } else if (request.request_type === 'virtual_card') { %>💳 Demande carte virtuelle
                <% } else { %><%= request.request_type %><% } %>
            </span>
        </div>
        <div class="detail-row">
            <span class="label">Statut actuel</span>
            <span class="badge badge-<%= request.status %>">
                <%= request.status === 'pending' ? 'En attente' :
                    request.status === 'in_review' ? 'En examen' :
                    request.status === 'approved' ? 'Approuvée' :
                    request.status === 'rejected' ? 'Refusée' :
                    request.status === 'completed' ? 'Complétée' :
                    request.status === 'cancelled' ? 'Annulée' : request.status %>
            </span>
        </div>
        <% if (request.details && Object.keys(request.details).length > 0) { %>
        <div class="detail-row">
            <span class="label">Détails</span>
            <span class="value" style="font-size:0.85rem;">
                <% if (request.details.account_number) { %>
                    Compte : <strong><%= request.details.account_number %></strong>
                <% } else { %>
                    <%= JSON.stringify(request.details) %>
                <% } %>
            </span>
        </div>
        <% } %>
        <div class="detail-row">
            <span class="label">Note de résolution</span>
            <span class="value"><%= request.resolution_note || '-' %></span>
        </div>
        <div class="detail-row">
            <span class="label">Date de demande</span>
            <span class="value"><%= new Date(request.created_at).toLocaleDateString('fr-FR') %></span>
        </div>
    </div>

    <!-- Info email -->
    <div style="margin:16px 0;padding:12px 16px;background:#eff6ff;border-left:4px solid #3b82f6;border-radius:6px;font-size:0.85rem;color:#1e40af;">
        📧 <strong>Information :</strong> Un email de notification sera automatiquement envoyé au client
        (<strong><%= request.email %></strong>) dès que vous approuvez ou refusez cette demande.
    </div>

    <form method="POST" action="/officer/requests/<%= request.request_type %>/<%= request.id %>/process">
        <input type="hidden" name="request_type" value="<%= request.request_type %>">
        <div class="form-group">
            <label for="status">Décision</label>
            <select id="status" name="status" required>
                <option value="in_review" <%= request.status === 'in_review' ? 'selected' : '' %>>En cours d'examen</option>
                <option value="approved">✅ Approuver (email envoyé au client)</option>
                <option value="rejected">❌ Refuser (email envoyé au client)</option>
                <option value="completed">Compléter</option>
                <option value="cancelled">Annuler</option>
            </select>
        </div>
        <div class="form-group">
            <label for="resolution_note">Note pour le client (optionnelle)</label>
            <textarea id="resolution_note" name="resolution_note" rows="3"
                placeholder="Ex: Votre compte épargne a été créé avec succès. / Motif du refus..."><%= request.resolution_note || '' %></textarea>
        </div>
        <button type="submit" class="btn-primary">Valider la décision</button>
    </form>
</div>
</body>
</html>
