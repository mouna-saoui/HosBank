<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demande Compte Épargne - HosBank</title>
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="container">
    <div class="page-header">
        <a href="/client/dashboard" class="btn-link">← Tableau de bord</a>
        <h1>Demande d'ouverture de compte épargne</h1>
    </div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
        <p>Soumettez une demande pour ouvrir un compte épargne. Un chargé client traitera votre demande.</p>
        <form method="POST" action="/requests/savings">
            <button type="submit" class="btn-primary">Soumettre la demande</button>
        </form>
    </div>

    <h2>Mes demandes</h2>
    <% if (requests.length === 0) { %>
        <p class="empty-text">Aucune demande pour le moment.</p>
    <% } else { %>
    <table class="table">
        <thead>
            <tr><th>Date</th><th>Statut</th><th>Note</th></tr>
        </thead>
        <tbody>
            <% requests.forEach(r => { %>
            <tr>
                <td><%= new Date(r.created_at).toLocaleDateString('fr-FR') %></td>
                <td><span class="badge badge-<%= r.status %>"><%= r.status %></span></td>
                <td><%= r.resolution_note || '-' %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>
</div>
</body>
</html>
