<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Compte épargne — HosBank</title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">
  <%- include('../layouts/sidebar', { userRole: 1, activePage: 'savings' }) %>
  <div class="main-content">
    <%- include('../layouts/topbar', { pageTitle: 'Demande compte épargne', userName: '' }) %>
    <main class="page-body">

      <div class="page-header">
        <a href="/client/dashboard" class="btn-link">← Tableau de bord</a>
      </div>

      <% if (error) { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>

      <div class="form-section" style="margin-bottom:28px;">
        <h2 style="font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:6px;">Ouvrir un compte épargne</h2>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:20px;">
          Soumettez une demande d'ouverture de compte épargne. Un chargé client traitera votre demande dans les meilleurs délais.
        </p>
        <form method="POST" action="/requests/savings">
          <button type="submit" class="btn btn-primary">Soumettre la demande</button>
        </form>
      </div>

      <div class="section-title">Mes demandes</div>
      <% if (requests.length === 0) { %>
        <div class="card"><p class="empty-text">Aucune demande pour le moment.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <div class="table-scroll">
            <table class="table">
              <thead><tr><th>Date</th><th>Statut</th><th>Note</th></tr></thead>
              <tbody>
                <% requests.forEach(r => { %>
                <tr>
                  <td style="white-space:nowrap;color:var(--text-muted);font-size:0.82rem;"><%= new Date(r.created_at).toLocaleDateString('fr-FR') %></td>
                  <td><span class="badge badge-<%= r.status %>"><%= r.status === 'pending' ? 'En attente' : r.status === 'approved' ? 'Approuvée' : r.status === 'rejected' ? 'Refusée' : r.status === 'completed' ? 'Complétée' : r.status %></span></td>
                  <td style="color:var(--text-muted);"><%= r.resolution_note || '—' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </main>
  </div>
</div>
</body>
</html>
