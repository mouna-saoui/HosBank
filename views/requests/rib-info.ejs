<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Informations RIB - HosBank</title>
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="container">
    <div class="page-header">
        <a href="/requests/rib" class="btn-link">← Retour</a>
        <h1>Vos informations RIB</h1>
    </div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } else { %>
    <div class="detail-card">
        <div class="detail-row">
            <span class="label">Numéro de compte</span>
            <span class="value"><%= ribInfo.accountNumber %></span>
        </div>
        <div class="detail-row">
            <span class="label">IBAN</span>
            <span class="value"><%= ribInfo.iban %></span>
        </div>
        <div class="detail-row">
            <span class="label">RIB</span>
            <span class="value"><strong><%= ribInfo.rib %></strong></span>
        </div>
        <div class="detail-row">
            <span class="label">Devise</span>
            <span class="value"><%= ribInfo.currency %></span>
        </div>
    </div>
    <% } %>
</div>
</body>
</html>
