<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — HosBank' : 'HosBank' %></title>
  <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
<div class="layout">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-name"> HosBank</div>
      <div class="brand-sub">Votre espace bancaire</div>
    </div>

    <nav class="sidebar-nav">
      <% if (typeof userRole !== 'undefined' && userRole === 1) { %>
        <div class="nav-section-label">Espace client</div>
        <a href="/client/dashboard" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <span class="nav-icon"></span> Tableau de bord
        </a>
        <a href="/accounts" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'accounts' ? 'active' : '' %>">
          <span class="nav-icon"></span> Mes comptes
        </a>
        <a href="/cards" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'cards' ? 'active' : '' %>">
          <span class="nav-icon"></span> Mes cartes
        </a>
        <div class="nav-section-label">Demandes</div>
        <a href="/requests/rib" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'rib' ? 'active' : '' %>">
          <span class="nav-icon"></span> Demande RIB
        </a>
        <a href="/requests/savings" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'savings' ? 'active' : '' %>">
          <span class="nav-icon"></span> Compte épargne
        </a>
      <% } else if (typeof userRole !== 'undefined' && (userRole === 2 || userRole === 3)) { %>
        <div class="nav-section-label">Espace agent</div>
        <a href="/officer/requests/rib" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'req-rib' ? 'active' : '' %>">
          <span class="nav-icon"></span> Demandes RIB
        </a>
        <a href="/officer/requests/savings_account" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'req-savings' ? 'active' : '' %>">
          <span class="nav-icon"></span> Demandes Épargne
        </a>
        <a href="/officer/cards" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'officer-cards' ? 'active' : '' %>">
          <span class="nav-icon"></span> Gestion cartes
        </a>
      <% } %>
    </nav>

    <div class="sidebar-footer">
      <a href="/logout" class="nav-item">
        <span class="nav-icon">↩</span> Déconnexion
      </a>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle" aria-label="Menu">☰</button>
        <span class="topbar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'HosBank' %></span>
      </div>
      <div class="topbar-right">
        <% if (typeof userName !== 'undefined') { %>
        <div class="topbar-user">
          <div class="topbar-avatar"><%= userName.charAt(0).toUpperCase() %></div>
          <span class="hide-mobile"><%= userName %></span>
        </div>
        <% } %>
      </div>
    </header>

    <main class="page-body">
      <%- body %>
    </main>
  </div>
</div>

<script>
  const toggle = document.getElementById('menuToggle');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('active'); }
  toggle.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('active'); });
  overlay.addEventListener('click', closeSidebar);
</script>
</body>
</html>
