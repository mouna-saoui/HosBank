<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Demandes — HosBank</title><link rel="stylesheet" href="/css/Style.css"></head>
<body><div class="layout"><%- include('../layouts/sidebar', { userRole, activePage }) %><div class="main-content"><%- include('../layouts/topbar', { pageTitle: 'Demandes', userName }) %><main class="page-body">
  <div class="page-header"><div><h1>Demandes bancaires</h1><p class="text-muted">Consultation et traitement des demandes</p></div><div class="header-actions"><a class="btn btn-outline btn-sm" href="/admin/requests?status=pending">En attente</a><a class="btn btn-outline btn-sm" href="/admin/requests">Toutes</a></div></div>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <div class="table-wrapper"><div class="table-scroll"><table class="table">
    <thead><tr><th>Client</th><th>Type</th><th>Date</th><th>Statut</th><th>Note</th><th>Action</th></tr></thead>
    <tbody><% requests.forEach(request => { %><tr>
      <td><%= request.first_name %> <%= request.last_name %><br><span class="text-muted"><%= request.email %></span></td><td><%= request.request_type %></td><td><%= new Date(request.created_at).toLocaleDateString('fr-FR') %></td>
      <td><span class="badge badge-<%= request.status %>"><%= request.status %></span></td><td><%= request.resolution_note || '-' %></td>
      <td><form method="POST" action="/admin/requests/<%= request.id %>/status"><select name="status"><% ['pending','in_progress','approved','rejected','completed','cancelled'].forEach(status => { %><option value="<%= status %>" <%= status === request.status ? 'selected' : '' %>><%= status %></option><% }) %></select><input type="hidden" name="resolution_note" value="Traitée par l'administrateur"><button class="btn btn-outline btn-sm" type="submit">Enregistrer</button></form></td>
    </tr><% }) %></tbody>
  </table></div></div>
</main></div></div></body></html>