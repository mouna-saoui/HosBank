<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Réclamations — HosBank</title><link rel="stylesheet" href="/css/Style.css"></head>
<body><div class="layout"><%- include('../layouts/sidebar', { userRole, activePage }) %><div class="main-content"><%- include('../layouts/topbar', { pageTitle: 'Réclamations', userName }) %><main class="page-body">
  <div class="page-header"><div><h1>Réclamations</h1><p class="text-muted">Consultation et suivi des réclamations</p></div><div class="header-actions"><a class="btn btn-outline btn-sm" href="/admin/complaints?status=open">Ouvertes</a><a class="btn btn-outline btn-sm" href="/admin/complaints">Toutes</a></div></div>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <div class="table-wrapper"><div class="table-scroll"><table class="table">
    <thead><tr><th>Client</th><th>Sujet</th><th>Description</th><th>Date</th><th>Statut</th><th>Action</th></tr></thead>
    <tbody><% complaints.forEach(complaint => { %><tr>
      <td><%= complaint.first_name %> <%= complaint.last_name %></td><td><%= complaint.subject %></td><td><%= complaint.description %></td><td><%= new Date(complaint.created_at).toLocaleDateString('fr-FR') %></td>
      <td><span class="badge badge-<%= complaint.status %>"><%= complaint.status %></span></td>
      <td><form method="POST" action="/admin/complaints/<%= complaint.id %>/status"><select name="status"><% ['pending','in_progress','resolved','rejected','closed'].forEach(status => { %><option value="<%= status %>" <%= status === complaint.status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="btn btn-outline btn-sm" type="submit">Enregistrer</button></form></td>
    </tr><% }) %></tbody>
  </table></div></div>
</main></div></div></body></html>